{
	"name": "sunburn-pwa",
	"private": true,
	"version": "0.7.3",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"lintstaged": "lint-staged",
		"typegen": "npx pocketbase-typegen --url='http://localhost:8090' --email 'test@s.b' --password 'passwordpassword' -o src/lib/pb-types.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/luxon": "^3.7.6",
		"@types/node": "^26.6.5",
		"daisyui": "^5.7.50",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-svelte": "^3.23.1",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^17.13.0",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"ts-xor": "^1.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vite-plugin-devtools-json": "^1.1.2"
	},
	"dependencies": {
		"@fontsource-variable/playwrite-us-trad": "^5.3.0",
		"@fontsource-variable/quicksand": "^5.3.0",
		"@fontsource/league-mono": "^5.3.0",
		"@fontsource/oxygen-mono": "^5.3.0",
		"@lucide/svelte": "^1.61.0",
		"@sapphi-red/web-noise-suppressor": "^0.4.1",
		"idb-keyval": "^6.3.0",
		"livekit-client": "^2.23.0",
		"luxon": "^3.7.2",
		"mdast-util-gfm-autolink-literal": "^2.0.1",
		"mdast-util-gfm-strikethrough": "^2.0.1",
		"micromark-extension-gfm-autolink-literal": "^2.1.0",
		"micromark-extension-gfm-strikethrough": "^2.1.0",
		"pocketbase": "^0.28.1",
		"rehype-external-links": "^3.0.0",
		"rehype-highlight": "^7.0.2",
		"rehype-katex": "^7.0.1",
		"rehype-stringify": "^10.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"runed": "~0.38.0",
		"theme-change": "^3.0.4",
		"tiny-markdown-editor": "^0.2.35",
		"tldts": "^7.4.19",
		"unified": "^11.0.5",
		"uuid": "^14.0.3",
		"virtua": "^0.53.6"
	},
	"lint-staged": {
		"*.svelte": [
			"prettier --check",
			"eslint --max-warnings=0"
		],
		"*.ts": [
			"prettier --check",
			"eslint --max-warnings=0 --no-warn-ignored"
		],
		"*.js": [
			"prettier --check",
			"eslint --max-warnings=0"
		],
		"*.json": [
			"prettier --check"
		],
		"*.css": [
			"prettier --check"
		],
		"*.md": [
			"prettier --check"
		]
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
